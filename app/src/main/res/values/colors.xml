    <!-- 顶栏纵向渐变的起始色（向下渐隐到 operit_bg）。
         v1.158.0：由 #2E2456 提亮到 #3A2A6E —— 旧值在深紫底上几乎看不出紫，
         「hero header」名存实亡（浏览器渲染对比证实）。 -->
    <color name="operit_header_start">#3A2A6E</color>
    <!-- 顶栏渐变中段（品牌紫 30%），向下再渐隐到透明，接住页面环境光 -->
    <color name="operit_header_fade">#4D7A66D8</color>

    <!-- ===== Operit 环境光（v1.158.0「Operit Glass v2」） =====
         玻璃要靠背后有光才成立。整页铺一层「顶紫 + 右紫 + 底紫」的径向光晕
         （bg_operit_page），卡片/导航的半透明白才叠出磨砂层次。
         这些只给 bg_operit_page 用，别当普通填充色。 -->
    <color name="operit_glow_top">#8C7A66D8</color>    <!-- 顶部主光：55% 品牌紫 -->
    <color name="operit_glow_edge">#3D9B8CF5</color>   <!-- 右上副光：24% 浅紫 -->
    <color name="operit_glow_bottom">#4D4A3D96</color> <!-- 底部回光：30% 深紫 -->

    <!-- ===== Operit Glass 玻璃层 token（v1.157.0） =====
         Android View 无法对背后内容做真实高斯模糊（原生 Window blur 要 API 31+，
         `RenderEffect` 只能糊自己内容），所以这里的「玻璃」＝
         半透明白叠加 + 1dp 高光描边 + 顶部渐亮，叠在深紫底上呈磨砂质感。
         所有玻璃组件必须引用下面这几个 token，不要在 drawable 里写死白透明度。 -->
    <color name="glass_fill">#17FFFFFF</color>         <!-- 玻璃底：~9% 白 -->
    <color name="glass_fill_strong">#24FFFFFF</color>  <!-- 抬升玻璃：~14% 白 -->
    <color name="glass_border">#29FFFFFF</color>      <!-- 玻璃描边高光：~16% 白 -->
    <color name="glass_border_soft">#14FFFFFF</color> <!-- 次级描边：~8% 白 -->
    <color name="glass_highlight">#33FFFFFF</color>   <!-- 玻璃顶部渐亮起点 -->
    <color name="glass_sheen">#0DFFFFFF</color>       <!-- 气泡内侧顶部柔光：~5% 白 -->
    <!-- 强调色玻璃（工具卡 / 当前角色卡等「系统行为」浮层）：
         不是白玻璃，而是 accent 染色玻璃，用来和普通内容卡区分。 -->
    <color name="glass_accent_top">#25B9A6FF</color>    <!-- accent 玻璃顶：~14.5% -->
    <color name="glass_border_accent">#47B9A6FF</color> <!-- accent 玻璃描边：~28% -->
    <!-- 按下涟漪：22% 白。ripple 语义独立于 highlight(20%)，故单列一档，
         供 operit_*_ripple 引用（issue #100）。 -->
    <color name="glass_ripple">#38FFFFFF</color>
    <!-- 「凹槽」底：参数/代码块这类嵌在玻璃卡里的下沉区域（38% 黑） -->
    <color name="glass_well">#61000000</color>
    <color name="glass_scrim">#B3000000</color>       <!-- 抽屉/弹窗遮罩：70% 黑 -->

