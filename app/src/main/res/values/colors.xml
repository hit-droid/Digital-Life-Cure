    <!-- ===== Operit Glass 玻璃层 token（v1.157.0） =====
         Android View 无法对背后内容做真实高斯模糊（原生 Window blur 要 API 31+，
         `RenderEffect` 只能糊自己内容），所以这里的「玻璃」＝
         半透明白叠加 + 1dp 高光描边 + 顶部渐亮，叠在深紫底上呈磨砂质感。
         所有玻璃组件必须引用下面这几个 token，不要在 drawable 里写死白透明度。 -->
    <color name="glass_fill">#16FFFFFF</color>         <!-- 玻璃底：~9% 白 -->
    <color name="glass_fill_strong">#24FFFFFF</color>  <!-- 抬升玻璃：~14% 白 -->
    <color name="glass_border">#28FFFFFF</color>      <!-- 玻璃描边高光：~16% 白 -->
    <color name="glass_border_soft">#14FFFFFF</color> <!-- 次级描边：~8% 白 -->
    <color name="glass_highlight">#33FFFFFF</color>   <!-- 玻璃顶部渐亮起点 -->
    <color name="glass_scrim">#B3000000</color>       <!-- 抽屉/弹窗遮罩：70% 黑 -->
</resources>
