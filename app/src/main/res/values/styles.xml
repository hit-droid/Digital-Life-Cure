<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 全局亮色主题：品牌色贯通系统控件，状态栏沉浸式 -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorControlActivated">@color/brand</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- 品牌圆角对话框 -->
    <style name="AppDialogTheme" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorControlActivated">@color/brand</item>
    </style>
</resources>
