<?xml version="1.0" encoding="utf-8"?>
<!-- 聊天页输入框（#96）：深色 surface 输入框。

     不能直接改公共 bg_input：它被子系统 UiKit.input 在全站使用，且底色是 card_bg
     （纯白），在 Operit 深色聊天页上是一块刺眼的亮斑，但同时它在浅色场景里是对的。
     所以这里做一份聊天页专用的深色版本，只影响本页。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/operit_surface" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="@color/operit_divider" />
</shape>
