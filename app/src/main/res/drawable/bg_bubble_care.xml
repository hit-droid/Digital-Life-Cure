<?xml version="1.0" encoding="utf-8"?>
<!-- v1.26.0：护理大脑 AI 气泡（深绿液态玻璃 + 薄荷绿 accent 竖线） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <!-- v1.27.0：液态玻璃渐变（对齐护理顶栏深绿体系），不再是扁平死色块 -->
            <gradient
                android:startColor="#1B5E45"
                android:centerColor="#16493A"
                android:endColor="#0F3D2E"
                android:angle="270" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <inset android:insetLeft="0dp" android:insetTop="8dp"
               android:insetBottom="8dp" android:insetRight="13dp">
            <shape android:shape="rectangle">
                <size android:width="3dp" />
                <solid android:color="#5BD9A8" />
                <corners android:radius="2dp" />
            </shape>
        </inset>
    </item>
</layer-list>
