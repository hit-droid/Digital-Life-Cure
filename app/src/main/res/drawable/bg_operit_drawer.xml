<?xml version="1.0" encoding="utf-8"?>
<!-- 侧栏抽屉面板（v1.158.0 Operit Glass v2）。
     ⚠️ 底层必须不透明：抽屉浮在会话列表之上又没有真实模糊，半透明会让底层文字透上来
     （v1.153.0 真机截图证实）。所以这里是「不透明 operit_surface 打底 + 顶部玻璃高光」，
     而不是直接把卡片那套半透明玻璃搬过来。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <!-- v1.158.0：由中性灰 #FF2A2A2A 收敛到品牌紫 surface，和页面底同一色系 -->
            <solid android:color="@color/operit_surface" />
            <corners android:topLeftRadius="16dp" android:bottomLeftRadius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/glass_highlight"
                android:endColor="@android:color/transparent" />
            <corners android:topLeftRadius="16dp" android:bottomLeftRadius="16dp" />
        </shape>
    </item>
</layer-list>
