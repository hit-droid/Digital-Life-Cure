<?xml version="1.0" encoding="utf-8"?>
<!-- 顶栏背景：品牌紫自顶部向下渐隐（Operit AI 风格「hero header」）。
     v1.158.0：改为三段渐变（起始 → 中段紫 → 透明），末端透明是为了**接住
     页面环境光（bg_operit_page）**而不是用不透明色盖出一块硬边；
     同时起始色提亮到 operit_header_start，紫才看得见。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- angle=270 才是「上→下」：起点色在顶部。写 90 会变成底部紫、顶部暗，
         顶栏底边会出现一条硬切边（v1.153.0 真机截图证实）。 -->
    <gradient
        android:angle="270"
        android:startColor="@color/operit_header_start"
        android:centerColor="@color/operit_header_fade"
        android:endColor="@android:color/transparent"
        android:type="linear" />
</shape>
