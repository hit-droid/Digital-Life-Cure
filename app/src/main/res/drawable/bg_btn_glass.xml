<?xml version="1.0" encoding="utf-8"?>
<!-- 次级「玻璃」按钮（记忆页「提取」等）。
     v1.157.0：并入统一 Glass 体系，顶光 + 高光描边，与卡片/胶囊/底部导航同语言。
     （此前用品牌单独的 brand_glass_bg 实色，与新的 glass_* 是两套口径。） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/glass_highlight"
        android:endColor="@color/glass_fill" />
    <corners android:radius="17dp" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_border" />
</shape>
