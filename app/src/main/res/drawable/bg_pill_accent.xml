<?xml version="1.0" encoding="utf-8"?>
<!-- 强调色胶囊（工具卡「执行中」状态、聊天页模型名 pill）。
     v1.158.0 Glass v2：由「深紫实底 + 全亮 accent 描边」（描边太重、像按钮）改为
     accent 玻璃胶囊——18% accent 底 + 28% accent 细描边，读起来是「状态标记」而非按钮。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/theme_accent_glass_top" />
    <stroke
        android:width="1dp"
        android:color="?attr/theme_accent_glass_border" />
    <corners android:radius="999dp" />
</shape>
