<?xml version="1.0" encoding="utf-8"?>
<!-- 工具调用卡片（ChatActivity.appendToolBubble）：accent 染色玻璃 + 强调色描边。
     与普通内容卡片区分：工具卡是「系统行为」，用 accent 染色标出，读起来像一层被点亮的玻璃。
     v1.158.0 Glass v2：白玻璃 → accent 染色玻璃（顶 accent 14.5% 渐隐到 5% 白），
     描边同步换成 accent 口径。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/glass_accent_top"
        android:endColor="@color/glass_sheen" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_border_accent" />
</shape>
