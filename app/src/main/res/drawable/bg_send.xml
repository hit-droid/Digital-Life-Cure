<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:startColor="@color/brand_dark"
                android:endColor="@color/brand"
                android:angle="315" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="@color/brand"
                android:endColor="@color/brand_end"
                android:angle="315" />
        </shape>
    </item>
</selector>
