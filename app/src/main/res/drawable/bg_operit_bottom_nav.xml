<?xml version="1.0" encoding="utf-8"?>
<!-- 底部导航：悬浮玻璃胶囊（v1.157.0「Operit Glass」）。
     与卡片同一套语言，但用 glass_fill_strong 抬升一档——它是常驻浮层，
     需要比内容卡片更「实」一点，才能在滚动的聊天内容上保持存在感。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/glass_highlight"
        android:endColor="@color/glass_fill_strong" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_border" />
</shape>
