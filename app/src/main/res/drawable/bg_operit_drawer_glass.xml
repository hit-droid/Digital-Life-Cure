<?xml version="1.0" encoding="utf-8"?>
<!-- 侧栏抽屉：启用真折射玻璃层时的「透明但保留圆角轮廓」底。
     玻璃面板由 render/LiquidGlassLayerView 画在抽屉**下层**，抽屉自身背景必须透明才能透出；
     但仍需要一个 drawable 提供圆角 outline——elevation 阴影与 clipToOutline 都依赖它。
     圆角与 bg_operit_drawer 完全一致（只圆左侧），故换成它后轮廓/裁切行为不变。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:topLeftRadius="16dp" android:bottomLeftRadius="16dp" />
</shape>
