<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#6C5CE7" android:endColor="#9B8CF5"
                android:angle="315" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <inset android:insetLeft="0dp" android:insetTop="0dp"
               android:insetRight="0dp" android:insetBottom="12dp">
            <shape android:shape="rectangle">
                <solid android:color="#0DFFFFFF" />
                <corners android:radius="16dp" />
            </shape>
        </inset>
    </item>
</layer-list>
