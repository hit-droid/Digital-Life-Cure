<?xml version="1.0" encoding="utf-8"?>
<!-- 聊天页发送 / 停止按钮（#96）：Operit 强调色实心圆。

     图标 ic_send 是纯白，起点色必须够深才有对比：原先从 operit_accent(#C4B5FD) 起，
     白箭头压在上面只有约 2.4:1（v1.153.0 真机截图偏糊）。改从 brand_operit_light 起，
     约 3.5:1；pressed 态继续压深一档，保留按压反馈。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:startColor="@color/brand_operit"
                android:endColor="@color/brand_operit_dark"
                android:angle="315" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="@color/brand_operit_light"
                android:endColor="@color/brand_operit"
                android:angle="315" />
        </shape>
    </item>
</selector>
