<?xml version="1.0" encoding="utf-8"?>
<!-- 当前角色卡（v1.158.0 Glass v2）：深紫渐变实色 + 2dp accent 描边 → accent 染色玻璃，
     描边降到 1.5dp，与全站玻璃卡片同一语言，不再是一块「更亮更厚的实心块」。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/glass_accent_top"
        android:endColor="@color/glass_fill_strong" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1.5dp"
        android:color="@color/operit_accent" />
</shape>
