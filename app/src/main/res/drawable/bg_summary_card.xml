<?xml version="1.0" encoding="utf-8"?>
<!-- 工具市场总览卡（v1.158.0 Glass v2）：实色 surface + 写死紫描边 → accent 染色玻璃，
     与工具调用卡（bg_tool）同口径。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/glass_accent_top"
        android:endColor="@color/glass_sheen" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_border_accent" />
</shape>
