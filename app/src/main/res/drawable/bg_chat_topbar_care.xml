<?xml version="1.0" encoding="utf-8"?>
<!-- 聊天页护理模式顶栏背景（#96）：薄荷绿自顶部向下渐隐融入 Operit 页面底色。

     旧 bg_top_bar_care 用的是大面积实心品牌绿，与 v1.150.0 落地的 Operit hero header
     语言不一致。这里沿用与 bg_operit_topbar 完全相同的「渐隐」结构，只把起始色换成
     薄荷绿，既保住「护理入口可辨识」，又与普通对话页同为一块渐隐 hero header。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 同 bg_operit_topbar：angle=270 才是「上→下」，否则顶栏底边出现硬切边。 -->
    <gradient
        android:angle="270"
        android:startColor="#2A5A4A"
        android:endColor="@color/operit_bg"
        android:type="linear" />
</shape>
