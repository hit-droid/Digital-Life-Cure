<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃列表磁贴（UiKit.listTile / switchTile / 关于弹窗信息卡）。
     v1.157.0 Glass：此前用 setBackgroundColor(operit_surface) 实色平铺，
     在深紫页面上是一块「死灰」；统一换成玻璃底 + 顶光 + 淡描边。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/glass_highlight"
        android:endColor="@color/glass_fill" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_border_soft" />
</shape>
